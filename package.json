{
  "name": "nightshift",
  "private": true,
  "version": "1.0.0",
  "description": "NIGHTSHIFT: Survive the Midnight - a cinematic rainy-night highway driving game that runs in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
